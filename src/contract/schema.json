{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theology-study-app.dev/contract/1.1.json",
  "title": "Teacher response contract v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "teacher", "blocks"],
  "properties": {
    "contract_version": { "enum": ["1.0", "1.1"] },
    "teacher": { "type": "string", "minLength": 1 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/framing" },
          { "$ref": "#/$defs/voice" },
          { "$ref": "#/$defs/passages" },
          { "$ref": "#/$defs/reading" },
          { "$ref": "#/$defs/prayer_prompt" }
        ]
      }
    }
  },
  "$defs": {
    "verseRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1001001, "maximum": 66999999 },
        "end": { "type": "integer", "minimum": 1001001, "maximum": 66999999 }
      }
    },
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "framing" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "section_id", "attribution", "quote"],
      "properties": {
        "type": { "const": "voice" },
        "section_id": { "type": "integer", "minimum": 1 },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["author", "work", "tradition", "origin"],
          "properties": {
            "author": { "type": "string", "minLength": 1 },
            "work": { "type": "string", "minLength": 1 },
            "year": { "type": "integer" },
            "tradition": { "type": "string", "minLength": 1 },
            "origin": { "enum": ["corpus", "user_library"] }
          }
        },
        "quote": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/verseRange" }
        }
      }
    },
    "passages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "passages" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end", "translation"],
            "properties": {
              "start": { "type": "integer", "minimum": 1001001, "maximum": 66999999 },
              "end": { "type": "integer", "minimum": 1001001, "maximum": 66999999 },
              "translation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "reading" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "title", "author"],
            "properties": {
              "source_id": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1 },
              "author": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "prayer_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "prayer_prompt" },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
