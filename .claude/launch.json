{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "theology-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "--turbopack"
      ],
      "port": 3002,
      "autoPort": true,
      "cwd": "web"
    },
    {
      "name": "theology-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "--port",
        "3003"
      ],
      "port": 3003,
      "autoPort": true,
      "cwd": "web"
    }
  ]
}
