diff --git a/.github/workflows/audit.yml b/.github/workflows/audit.yml
index fc43754..dc03976 100644
--- a/.github/workflows/audit.yml
+++ b/.github/workflows/audit.yml
@@ -33,32 +33,82 @@ jobs:
   db-invariants:
     runs-on: ubuntu-latest
     steps:
+      # TWO secrets now. APP_DATABASE_URL_TEST (app_runtime) drives the RLS/tenancy suites; the
+      # owner URL DATABASE_URL_TEST drives the schema/migration suites that must SEED and DELETE
+      # (app_runtime is SELECT-only on the corpus, so those cannot run as app_runtime by design).
+      # Both point at the disposable Neon `ci` branch — NEVER dev, NEVER prod. The suites carry
