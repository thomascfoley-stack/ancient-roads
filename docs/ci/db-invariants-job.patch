+      - if: steps.guard.outputs.owner == 'true'
+        name: hygiene — no test residue left on the ci branch
+        env:
+          DATABASE_URL: ${{ secrets.DATABASE_URL_TEST }}
+        run: node scripts/check-test-residue.mjs
