+      #    was green while they enforced nothing.
+      - if: steps.guard.outputs.owner == 'true'
+        name: owner-role invariants — schema, migrations, reader, search (real DB)
         working-directory: web
         env:
           REQUIRE_DB: '1'
+          DATABASE_URL: ${{ secrets.DATABASE_URL_TEST }}
           APP_DATABASE_URL: ${{ secrets.APP_DATABASE_URL_TEST }}
