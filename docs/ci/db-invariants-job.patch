+          APP_DATABASE_URL: ${{ secrets.APP_DATABASE_URL_TEST }}
+        run: >
+          corepack pnpm exec vitest run
+          test/invariants/licensing.test.ts
+          test/invariants/tenancy.test.ts
+          test/invariants/highlight-tenancy.test.ts
+          test/invariants/annotation-exact-substring.test.ts
+          test/invariants/annotation-rls-tenancy.test.ts
+
+      # ── owner-role suites: these SEED and DELETE fixtures (throwaway sources/sections), which
