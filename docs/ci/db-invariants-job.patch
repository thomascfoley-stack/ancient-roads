+          test/invariants/sections-unit-ordinal.test.ts
+          test/invariants/annotations-polymorphic.test.ts
+          test/invariants/annotation-tables.test.ts
+          test/invariants/library-published-boundary.test.ts
+          test/invariants/search-sections.test.ts
+          test/invariants/register-wall-surfaces.test.ts
+
+      # ── residue gate: the suites above SEED shared state. This is the class-level guard that
