       - id: guard
         env:
-          DBURL: ${{ secrets.APP_DATABASE_URL_TEST }}
+          APPURL: ${{ secrets.APP_DATABASE_URL_TEST }}
+          OWNERURL: ${{ secrets.DATABASE_URL_TEST }}
         run: |
-          if [ -z "$DBURL" ]; then
-            echo "run=false" >> "$GITHUB_OUTPUT"
-            echo "::warning title=DB invariants NOT RUN::licensing + tenancy invariants were skipped — repo secret APP_DATABASE_URL_TEST (Neon test branch) is not set. See OWNER_ACTIONS §1. This job goes green as a visible placeholder; the invariants run for real once the secret exists."
+          if [ -z "$APPURL" ]; then
+            echo "app=false" >> "$GITHUB_OUTPUT"
+            echo "::warning title=DB invariants NOT RUN::app_runtime suites skipped — repo secret APP_DATABASE_URL_TEST is not set. This job goes green as a VISIBLE placeholder; it is not a pass."
           else
-            echo "run=true" >> "$GITHUB_OUTPUT"
+            echo "app=true" >> "$GITHUB_OUTPUT"
           fi
-      - if: steps.guard.outputs.run == 'true'
+          if [ -z "$OWNERURL" ]; then
+            echo "owner=false" >> "$GITHUB_OUTPUT"
+            echo "::warning title=OWNER-role invariants NOT RUN::schema/migration suites skipped — repo secret DATABASE_URL_TEST (owner on the Neon ci branch) is not set. This job goes green as a VISIBLE placeholder; it is not a pass."
+          else
+            echo "owner=true" >> "$GITHUB_OUTPUT"
+          fi
+      - if: steps.guard.outputs.app == 'true' || steps.guard.outputs.owner == 'true'
         uses: actions/checkout@v4
         with:
           fetch-depth: 0
-      - if: steps.guard.outputs.run == 'true'
+      - if: steps.guard.outputs.app == 'true' || steps.guard.outputs.owner == 'true'
         uses: actions/setup-node@v4
         with:
           node-version: 22
-      - if: steps.guard.outputs.run == 'true'
+      - if: steps.guard.outputs.app == 'true' || steps.guard.outputs.owner == 'true'
         run: corepack enable
-      - if: steps.guard.outputs.run == 'true'
+      - if: steps.guard.outputs.app == 'true' || steps.guard.outputs.owner == 'true'
         run: corepack pnpm install --frozen-lockfile
-      - if: steps.guard.outputs.run == 'true'
-        name: licensing + tenancy invariants (real DB)
