# @neondatabase/auth@0.4.2-beta declares a peer of next>=16, but it works fine
# on Next 15 (verified locally under pnpm, which tolerates the peer). Vercel's
# remote build uses npm, whose strict peer resolution fails with ERESOLVE.
# legacy-peer-deps matches pnpm's lenient behavior so the deploy installs.
legacy-peer-deps=true
