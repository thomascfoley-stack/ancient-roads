# Copy to .env.local (same directory) and fill in. NAMES ONLY — never commit real values.
# Full reference, including what silently no-ops without each var: ../docs/ENVIRONMENT.md

# --- Database (Neon Postgres + pgvector) ---
# Least-privilege app_runtime pooled URL — the web runtime connects with this (RLS binds).
# Production REFUSES to boot without it (no owner fallback).
APP_DATABASE_URL="postgresql://APP_RUNTIME_USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Owner URL — migrations/DDL (db/migrate.mjs) and offline scripts; also the dev runtime fallback.
DATABASE_URL="postgresql://OWNER_USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct (unpooled) owner URL — required by embedding/ingest scripts.
DATABASE_URL_UNPOOLED="postgresql://OWNER_USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Destructive-ingest guard: must be dev or test, from the same source as DATABASE_URL.
NEON_BRANCH=dev

# --- Auth (Neon Auth) ---
# Neon Auth service base URL (Neon dashboard → Auth).
NEON_AUTH_BASE_URL="https://YOUR_NEON_AUTH_HOST"
# Secret that signs the auth session cookie (generate a long random string).
NEON_AUTH_COOKIE_SECRET="REPLACE_ME_LONG_RANDOM"

# --- DeepInfra (embed + rerank + compose; models pinned per docs/DECISIONS.md ADR-005) ---
# /api/ask throws without it; eval/ingest scripts fail; integration tests skip.
DEEPINFRA_API_KEY="REPLACE_ME"

# --- Site gate + eval harness ---
# Pre-launch password wall. Production fails CLOSED (503 everywhere) when unset; dev runs gate-free.
SITE_PASSWORD="REPLACE_ME"
# Bearer token for the local /api/eval/bait harness (dev/test only; the route 404s in prod).
EVAL_HARNESS_SECRET="REPLACE_ME_64_HEX_CHARS"

# --- Optional (defaults shown; unset = default) ---
# Comma-separated conditional-license work ids the owner acknowledges (predeploy gate).
# LICENSE_ACK=leb
# metadataBase override; defaults to https://ancientpaths.app.
# NEXT_PUBLIC_SITE_URL=https://ancientpaths.app
# Rate limits: per-user /api/ask (10/min, 100/day) and per-IP gate throttle (10/min, 60/hour).
# ASK_LIMIT_PER_MIN=10
# ASK_LIMIT_PER_DAY=100
# GATE_LIMIT_PER_MIN=10
# GATE_LIMIT_PER_HOUR=60
# Composio integrations backend (ADR-011) — not yet wired into any route.
# COMPOSIO_API_KEY=

# Vercel Blob — raw uploaded files for My Works (Slice 1). The store is PRIVATE
# (access: 'private'); a user's sermon manuscript must never sit at a public URL.
# Injected into Production, Preview AND Development by the store's project connection.
# NOT marked Sensitive: Vercel forbids Sensitive vars from targeting Development, and the
# owner chose Development coverage over unreadability (ADR-101). The token can read and
# delete every user's uploads, so treat it as a live credential.
# For local work, copy it from the store's .env.local quickstart tab.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
