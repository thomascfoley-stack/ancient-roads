{
  "name": "theology-study-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "precommit": "bash .githooks/pre-commit",
    "audit": "bash scripts/audit.sh",
    "qa": "vitest run --config web/vitest.config.ts && vitest run test/rate-limit.test.ts",
    "qa:baseline": "node web/test/scripts/update-forbidden-provenance-baseline.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/evals/run.ts",
    "ingest:web": "tsx src/ingest/ingest-web.ts",
    "ingest:api": "tsx src/ingest/ingest-api.ts",
    "ingest:commentaries": "tsx src/ingest/ingest-commentaries.ts",
    "ingest:commentary-api": "tsx src/ingest/ingest-commentary-api.ts",
    "ingest:merge-commentaries": "tsx src/ingest/merge-commentaries.ts",
    "ingest:embeddings": "tsx src/ingest/ingest-embeddings.ts",
    "ingest:commentary-fts": "tsx src/ingest/ingest-commentary-fts.ts",
    "ingest:concordance": "tsx src/ingest/build-concordance.ts",
    "teacher": "tsx src/teacher/run.ts",
    "gate:ingest": "tsx src/ingest/gate-ingest.ts",
    "check:coverage": "tsx src/ingest/check-corpus-coverage.ts",
    "check:coverage:sections": "tsx src/ingest/check-corpus-coverage.ts --target=sections",
    "check:licenses": "tsx src/ingest/check-licenses.ts",
    "check:data": "pnpm check:licenses && pnpm check:coverage",
    "migrate:sections-slice": "tsx src/ingest/migrate-sections-slice.ts",
    "repoint:sections": "tsx src/ingest/repoint-sections-work.ts",
    "preflight:ingest": "node scripts/ingest-preflight.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "ajv": "^8.17.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "knip": "^6.25.0",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.22",
      "fast-uri": "^3.1.4",
      "sharp": "^0.35.0",
      "better-auth": "^1.6.25",
      "@better-auth/passkey": "^1.6.25",
      "@better-fetch/fetch": "^1.3.1"
    },
    "auditConfig": {
      "//": "SEC-1 fix attempt 2026-07-29 (docs/SECURITY.md): pnpm.overrides force the ENTIRE better-auth subtree to >=1.6.25 (better-auth + @better-auth/passkey + @better-fetch/fetch move together - the 2026-07-08 attempt moved only better-auth and broke the build on the 1.4.18 remainder). GHSA-g38m and GHSA-qq9h are both patched at 1.6.22+. Ignore list cleared so the advisory gate re-arms; if a specific advisory still fires on the 1.6.x tree, re-add ONLY that id with a dated note here and in docs/SECURITY.md.",
      "ignoreGhsas": []
    }
  }
}
