# Copy to .env.prod (gitignored, chmod 600). Owner-only — prod cutover credential.
# NAMES ONLY. Never commit real values or paste them into chat.
#
# Used by: scripts/cutover.mjs, scripts/prod-census.cjs
#   set -a && source .env.prod && set +a
#   node scripts/cutover.mjs --preflight

NEON_BRANCH=br-your-prod-branch-id
# Direct (unpooled) neondb_owner URL for the production branch.
CUTOVER_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
